{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "LogLevel": { "Default": "Warning" }
    }
  },
  "Collector": {
    "DataDir": "..\\data",
    "StateFile": null,
    "PollSeconds": 2,
    "BatchMaxLines": 5000,
    "BatchMaxBytes": 8388608,
    "StartAtEnd": false,
    "DeleteShipped": true,
    "DeleteAfterMinutes": 70,
    "UnverifiedRetentionHours": 48,
    "ClickHouse": {
      "Url": "http://localhost:8123",
      "Database": "monitor",
      "User": "default",
      "Password": "",
      "TimeoutSeconds": 30,
      "IgnoreTlsErrors": false,
      "CreateSchema": true,
      "TtlDays": 30,
      "RollupTtlDays": 400
    }
  }
}
