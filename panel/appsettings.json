{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "IntervalSeconds": 10,
    "HistorySize": 360,
    "FailuresToDown": 2,
    "Targets": [
      {
        "Id": "site",
        "Name": "Site PHP (local)",
        "Url": "http://localhost:8080/",
        "HealthUrl": "http://localhost:8080/_monitor/health.php",
        "TracesUrl": "http://localhost:8080/_monitor/traces.php",
        "Token": "dev-token",
        "TimeoutSeconds": 5,
        "SlowMs": 1000
      }
    ]
  }
}
